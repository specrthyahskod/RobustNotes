{
  "schema": 4,
  "required_executas": [
    {
      "tool_id": "bundled:notes-core"
    }
  ],
  "tags": ["robustnotes-anna"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "RobustNotes",
